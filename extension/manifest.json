{
  "manifest_version": 3,
  "name": "JKT48 Quota Checker",
  "version": "1.0.0",
  "description": "Pantau dan cari kuota tiket/event JKT48 secara real-time langsung di browser yang sudah login.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://jkt48.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "JKT48 Quota Checker",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://jkt48.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
